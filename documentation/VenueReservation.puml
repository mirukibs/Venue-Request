@startuml Venue Reservation Bounded Context - Domain Model
title Venue Reservation Bounded Context - Domain Model

skinparam classAttributeIconSize 0

package "Venue Reservation Domain" {

'=========================
' Aggregate Roots
'=========================

class VenueRequest <<Aggregate Root>> {
    - id : UUID
    - title : String
    - description : String
    - requesterId : UUID
    - venueId : UUID
    - timePeriod : TimePeriod
    - status : RequestStatus

    + submit()
    + approve()
    + reject()

    + isDraft()
    + isPendingReview()
    + isApproved()
    + isRejected()
}

class Reservation <<Aggregate Root>> {
    - id : UUID
    - venueId : UUID
    - venueRequestId : UUID
    - requesterId : UUID
    - timePeriod : TimePeriod
    - status : ReservationStatus

    + confirm()
    + cancel()
}

class Venue <<Aggregate Root>> {
    - id : UUID
    - name : String
    - size : VenueSize
    - facilities : List<String>

    + rename(name)
    + updateFacilities()
}

'=========================
' Value Objects
'=========================

class TimePeriod <<Value Object>> {
    - date : LocalDate
    - startTime : LocalTime
    - endTime : LocalTime

    + overlaps(period)
    + duration()
    + isValid()
}

'=========================
' Enumerations
'=========================

enum RequestStatus {
    DRAFT
    PENDING_REVIEW
    APPROVED
    REJECTED
}

enum VenueSize {
    SMALL
    MEDIUM
    LARGE
}

enum ReservationStatus {
    CONFIRMED,
    CANCELLED
}

'=========================
' Domain Service
'=========================

class ReservationAvailabilityPolicy <<Domain Service>> {
    + ensureNoOverlappingReservations(
        venueId,
        timePeriod
    )
}

'=========================
' Repository Interfaces
'=========================

interface VenueRequestRepository {
    + save(request)
    + findById(id)
}

interface ReservationRepository {
    + save(reservation)
    + findById(id)
    + findReservationsForVenue(venueId)
}

interface VenueRepository {
    + save(venue)
    + findById(id)
}

}

'=========================
' Relationships
'=========================

VenueRequest *-- TimePeriod
Reservation *-- TimePeriod

Venue --> VenueSize

VenueRequest --> RequestStatus

Reservation --> VenueRequest : references
VenueRequest --> Venue : references
Reservation --> Venue : reserves

ReservationAvailabilityPolicy ..> ReservationRepository
ReservationAvailabilityPolicy ..> Reservation
ReservationAvailabilityPolicy ..> TimePeriod

VenueRequestRepository ..> VenueRequest
ReservationRepository ..> Reservation
VenueRepository ..> Venue

@enduml